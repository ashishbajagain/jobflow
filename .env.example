# Auth (required in production — Serverless + Middleware)
AUTH_SECRET=generate-a-long-random-string-here
APP_URL=http://localhost:3000

# Transactional email via Resend (https://resend.com)
# Must use a VERIFIED domain so emails can go to any user — not @resend.dev
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=JobFlow <noreply@ashishb.com.np>

# Durable SQLite for production / multi-user (Turso — https://turso.tech)
# Required on Vercel: local file SQLite in /tmp is ephemeral across serverless instances.
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=eyJ...
